{
  "name": "church-presenter",
  "version": "0.1.0",
  "description": "Church media presentation software (lyrics, media backgrounds, Bible verses, lower thirds, playlists) for live worship display.",
  "private": true,
  "author": {
    "name": "New Testament Church of God, Barbados"
  },
  "main": "dist-electron/electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "tsc -p electron/tsconfig.json --watch",
    "dev": "concurrently -k -n VITE,ELECTRON -c blue,green \"npm:dev:renderer\" \"npm run wait-and-launch\"",
    "wait-and-launch": "tsc -p electron/tsconfig.json && wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "cross-env NODE_ENV=production electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json",
    "predist": "npm run build",
    "dist": "electron-builder --publish=never",
    "dist:linux": "npm run build && electron-builder --linux --publish=never",
    "dist:mac": "npm run build && electron-builder --mac --publish=never",
    "dist:win": "npm run build && electron-builder --win --publish=never"
  },
  "build": {
    "appId": "com.churchpresenter.app",
    "productName": "Sanctuary",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/**/*",
      "build-assets/icon.ico",
      "build-assets/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build-assets"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "node_modules/@grandi/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "electron-store": "^8.2.0",
    "fast-xml-parser": "^4.5.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "grandi": "^2.0.2",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.6.82",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.11.0",
    "uuid": "^9.0.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/ffmpeg-static": "^3.0.3",
    "@types/ffprobe-static": "^2.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.4.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "wait-on": "^7.2.0"
  }
}
